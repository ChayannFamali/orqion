# orqion — пример конфигурации.
# Скопируй в .env и заполни при необходимости.
# Все параметры имеют значения по умолчанию для профиля minimal.
# Приложение стартует без единой переменной окружения.

# ORQION_APP_NAME=orqion
# ORQION_PROFILE=minimal
# ORQION_HOST=127.0.0.1
# ORQION_PORT=8000
# ORQION_LOG_LEVEL=INFO

# ORQION_DATABASE_URL=sqlite:///./orqion.db

# ORQION_VECTOR_STORE=sqlite-vec
# ORQION_QDRANT_URL=
# ORQION_QDRANT_API_KEY=

# ORQION_BLOB_STORE_PATH=./data/blobs

# ORQION_EMBEDDINGS_MODEL=BAAI/bge-m3
# ORQION_EMBEDDINGS_BACKEND=local

# Оставь пустым для автогенерации (файл data/.secret_key, права 0o600).
# ORQION_SECRET_KEY=

# ORQION_SESSION_COOKIE_SECURE=false

# Срок жизни сессии. Значение действует до первой записи в настройках
# рабочей области (Настройки → Общие → Сессии и безопасность).
# ORQION_SESSION_TTL_DAYS=7

# Лимиты загрузки документов: действуют и на загрузку в интерфейсе, и на
# импорт из командной строки. Значения действуют до первой записи в
# настройках рабочей области (Настройки → Общие → Файлы и хранение).
# Каждое расширение указывается с точкой; пустая строка запрещает
# загрузку всех файлов.
# ORQION_MAX_UPLOAD_SIZE_MB=50
# ORQION_ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.pptx,.xlsx,.py,.cpp,.ts,.go,.java,.sql,.md,.txt

# Температура генерации, если в запросе она не указана. Значение действует
# до первой записи в настройках рабочей области (Настройки → Общие →
# Модель по умолчанию).
# ORQION_DEFAULT_TEMPERATURE=0.7

# ORQION_PROBE_INTERVAL_SECONDS=900

# Вход через внешнего поставщика учётных записей (OpenID Connect).
# По умолчанию отключён — локальный вход работает без env.
# Для включения: pip install orqion[oidc] + заполнить все поля ниже.
# ORQION_OIDC_ENABLED=false
# ORQION_OIDC_CLIENT_ID=
# ORQION_OIDC_CLIENT_SECRET=
# ORQION_OIDC_ISSUER=https://idp.example.com/realms/orqion
# ORQION_OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
# JSON: {"engineering":"developer","admins":"admin"}
# ORQION_OIDC_GROUP_ROLE_MAP={}
# Роль для пользователей, чья группа не в mapping (deny-by-default).
# ORQION_OIDC_DEFAULT_ROLE=support

# Синхронизация групп внешнего поставщика: фоновое обновление групп и
# отзыв доступа при удалении учётной записи у поставщика.
# Отдельно от OIDC_ENABLED: хранит долгоживущий refresh_token per-user
# (зашифрованный AES-GCM). Включайте осознанно — это новый класс секрета.
# ORQION_OIDC_SYNC_ENABLED=false
# ORQION_OIDC_SYNC_INTERVAL_SECONDS=300
